# Build and run settings for qialike desktop — a template, not a loaded file.
#
# Nothing reads this file automatically: the build and the application read the process environment.
# Copy it to `.env.local` (gitignored) and load it into your shell before building:
#
#     cp .env.example .env.local
#     $EDITOR .env.local
#     set -a; . ./.env.local; set +a
#
# Every value below is optional. The defaults are what the build uses when a variable is unset, and
# they are listed beside each one so this file stays documentation rather than configuration.
#
# Do not put credentials here. Signing material is read from the environment by electron-builder and
# is deliberately not described as a value to paste into a tracked-file template; see CONTRIBUTING.md.

# ---------------------------------------------------------------------------
# The two read-only upstream checkouts
# ---------------------------------------------------------------------------

# The deepseek-harness checkout the runtime is composed from. It must already be built
# (`pnpm install && pnpm run build` inside it) and inside the version range in
# apps/desktop-bin/lib/harness-version.mjs.
#
# Default: `../deepseek-harness`, a sibling of this repository. The same variable is read by the
# qialike CLI's own build, so one setting points both products at one harness.
# DSH_HARNESS=/home/you/src/deepseek-harness

# The qialike CLI checkout. It must be the exact release `CLI_VERSION` names in
# apps/desktop-bin/lib/harness-version.mjs, and it must have been built at that release — the build
# copies its `lib/` into the runtime tree rather than adapting to it.
#
# Default: `../qialike` when that is a checkout, then `~/deepseek/qialike`.
# DSH_QIALIKE=/home/you/src/qialike

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------

# The pnpm content-addressable store used to assemble the runtime tree under `dist/`. Pinned inside
# the checkout by default (`.pnpm-store`) because pnpm's global default is unusable wherever writes
# outside the project are not permitted. Overridden by `--store-dir` on the build command line.
# QIALIKE_PNPM_STORE=/home/you/.cache/qialike-pnpm-store

# Where the built Web frontend is read from, when you have a harness Web build somewhere other than
# the harness checkout. Overridden by `--web-frontend` on the build command line.
# (no environment variable; the flag is the only way to set this)

# ---------------------------------------------------------------------------
# Packaging
# ---------------------------------------------------------------------------

# The update feed baked into the package. When set, the artifact gains `resources/app-update.yml` and
# the output directory gains `latest.yml`; when unset, the build has no update capability and says so
# once at startup. It must be a real, fetchable URL — an unreachable placeholder produces an
# application whose updater fails for every user.
# QIALIKE_DESKTOP_UPDATE_URL=https://github.com/qialike/qialike-desktop/releases/latest/download

# Leave the bundled Office engine out and install it on demand instead. Accepts `plugin` (the only
# non-default value); the default bundles the engine.
# QIALIKE_DESKTOP_OFFICE_ENGINE=plugin

# Permit a macOS or Windows package that is not signed. Linux never requires a signature. `0` is a
# falsey spelling of "no", not consent.
# DSH_DESKTOP_UNSIGNED=1

# Signing material, read by electron-builder. Set these in the environment of the packaging run, not
# in a file that can be committed: on macOS `CSC_LINK` (or `CSC_NAME`) plus `APPLE_ID`,
# `APPLE_APP_SPECIFIC_PASSWORD` and `APPLE_TEAM_ID` for notarization; on Windows `CSC_LINK` (or
# `WIN_CSC_LINK`) or `CSC_NAME`.
# CSC_LINK=file:///home/you/secrets/certificate.p12
# CSC_NAME=Developer ID Application: Example (TEAMID)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234

# ---------------------------------------------------------------------------
# Running the application
# ---------------------------------------------------------------------------

# The shared home the application reads and writes: sessions, credentials, provider routes, colour
# schemes. It defaults to `~/.dsh` and is the SAME home the qialike CLI uses — which is the point,
# and also why pointing it at a scratch directory is the right way to test a destructive change.
# DSH_HOME=/home/you/.dsh
