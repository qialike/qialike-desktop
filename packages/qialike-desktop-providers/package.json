{
  "name": "@qialike/qialike-desktop-providers",
  "description": "The qialike desktop provider catalogue: the CLI's model layer re-hosted as rows this profile can mount, one subpath per loadable group",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./llm": {
      "types": "./lib/llm.d.ts",
      "default": "./lib/llm.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
