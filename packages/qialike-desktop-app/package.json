{
  "name": "@qialike/qialike-desktop-app",
  "description": "The qialike desktop bundle: layered over dsh-base + dsh-web-app to give the deepseek-harness browser surface qialike's branding, provider catalogue, themes, and file tools",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@qialike/qialike-desktop-brand": "workspace:*",
    "@qialike/qialike-desktop-edit-follow": "workspace:*",
    "@qialike/qialike-desktop-export": "workspace:*",
    "@qialike/qialike-desktop-office-engine": "workspace:*",
    "@qialike/qialike-desktop-policy": "workspace:*",
    "@qialike/qialike-desktop-providers": "workspace:*",
    "@qialike/qialike-desktop-theme": "workspace:*",
    "@qialike/qialike-desktop-update": "workspace:*",
    "@qialike/qialike-desktop-voice": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
